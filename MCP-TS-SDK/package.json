{
  "name": "mcp-ts-sdk",
  "version": "1.0.0",
  "description": "MCP-enabled DuckDB query application with AI agent",
  "main": "dist/index.js",
  "scripts": {    
    "importdb": "tsx import-database-parquet.ts",
    "dev": "tsx src/index.ts",
    "server": "tsx mcp-duckdb-server",
    "agent": "npx ts-node runAgent",
    "agent:ollama": "npx ts-node runAgent ollama",
    "agent:mcp": "npx ts-node runAgent MCP",
    "mcpagent": "npx ts-node runAgent-mcp",
    "mcpagent:ollama": "npx ts-node runAgent-mcp ollama",
    "mcpagent:mcp": "npx ts-node runAgent-mcp MCP",
    
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.x.x",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "duckdb-async": "^1.0.0",
    "express": "^4.18.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "duckdb",
    "bedrock",
    "ai-agent",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT"
}
